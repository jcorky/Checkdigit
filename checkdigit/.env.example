# ============================================================================
# CHECKDIGIT configuration.  Copy to ".env":   cp .env.example .env
# Everything here is OPTIONAL — with an empty .env the app runs fully (Tier 0).
# Uncomment only the tiers you want.  Every variable below is read by the code;
# none are decorative.  docker compose reads this file automatically.
# ============================================================================

# ---------------------------------------------------------------------------
# TIER 0 — core (works with no config; these two are just "strongly recommended")
# ---------------------------------------------------------------------------
# SQLite path. In Docker leave as-is (it lands on the 'data' volume). Bare-metal,
# point it wherever you want the audit + warehouse DB to live.
CHECKDIGIT_DB=/data/checkdigit.db

# The REAL BIC owner-code register (CSV/JSON you download from bic-code.org).
# Powers owner names AND free-text corroboration. The shipped owner_registry.seed.csv
# is a ~5-row SAMPLE, not the register. If you set this to a missing path the app
# FAILS LOUDLY at startup (by design) rather than pretending enrichment works.
CHECKDIGIT_OWNER_REGISTRY=/data/owner_registry.csv

# Optional: directory of the built SPA (defaults to ./static). Same-origin serve.
# CHECKDIGIT_STATIC=/app/static

# Optional operator policy file (JSON rules layer: per-prefix strict/lenient,
# allow/deny lists). Loaded at startup; editable live via PUT /policy. Example:
#   {"default_policy":"strict","allow":["LEA"],"deny":["TES"],
#    "per_prefix":{"MSC":"lenient"}}
# CHECKDIGIT_POLICY_FILE=/data/policy.json

# ---------------------------------------------------------------------------
# TIER 1 — web UI cross-origin (only if SPA is served from a DIFFERENT origin)
# ---------------------------------------------------------------------------
# Comma-separated. Omit entirely when the SPA is built into static/ (same origin).
# CHECKDIGIT_CORS_ORIGINS=https://thecheckdigit.com

# ---------------------------------------------------------------------------
# TIER 2 — public hosting via Cloudflare Tunnel (docker-compose.public.yml)
# ---------------------------------------------------------------------------
# Token from Zero Trust > Networks > Tunnels > your tunnel. Required ONLY for the
# public compose file; the private/LAN stack does not use it.
# CLOUDFLARED_TOKEN=eyJ...your-tunnel-token...

# Public origin (scheme + host, NO trailing slash). Used for CORS and to derive
# the OAuth redirect URI in docker-compose.public.yml.
# PUBLIC_ORIGIN=https://app.thecheckdigit.com

# ---------------------------------------------------------------------------
# TIER 2b — admin dashboard sign-in via Google (gates dashboard/history/registry)
#   The upload/correct app stays PUBLIC; only the warehouse read views require
#   sign-in, enforced server-side. Turn it on with CHECKDIGIT_ADMIN_AUTH=google;
#   if it's on and ANY value below is missing (or the allow-list is empty), the
#   app FAILS LOUD at startup -- it never leaves the dashboard open. Create the
#   OAuth client in Google Cloud Console (APIs & Services > Credentials > OAuth
#   client ID > Web application) and add the redirect URI below (must byte-match).
# ---------------------------------------------------------------------------
# CHECKDIGIT_ADMIN_AUTH=google
# CHECKDIGIT_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxx.apps.googleusercontent.com
# CHECKDIGIT_GOOGLE_CLIENT_SECRET=...
# CHECKDIGIT_ADMIN_EMAILS=jayde.cork@gmail.com         # comma-separated allow-list
# CHECKDIGIT_SESSION_SECRET=                           # 48+ random bytes:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# CHECKDIGIT_COOKIE_SECURE=1                           # 1 behind HTTPS (prod); 0 for local http
# CHECKDIGIT_DOCS=1                                    # 0 disables Swagger/OpenAPI (set 0 in prod)
# Bare-metal only (docker-compose.public.yml derives this from PUBLIC_ORIGIN):
# CHECKDIGIT_OAUTH_REDIRECT_URI=https://app.thecheckdigit.com/admin/auth/callback

# ---------------------------------------------------------------------------
# TIER 3 — live enrichment (ALL opt-in; an adapter is dark until its key is set)
#   Each needs a FREE account you register for. Background-task only: never
#   blocks /correct. Optional *_PREFIXES scopes an adapter to the owner prefixes
#   it actually covers, so a box is only queried against the carrier that owns it.
# ---------------------------------------------------------------------------

# BIC BoxTech — size/type, tare, owner. Free account (email verify). OAuth2.
# BOXTECH_USERNAME=you@example.com
# BOXTECH_PASSWORD=...
# BOXTECH_ENV=prod                 # 'uat' to hit the sandbox host instead
# BOXTECH_CONTAINER=               # (test override; leave unset in normal use)

# Maersk Track & Trace Plus — free, self-service Consumer-Key.
# MAERSK_CONSUMER_KEY=...
# MAERSK_BEARER=                   # optional, if your product also issues one
# MAERSK_PREFIXES=MAE,MSK,MRK,SUD,SEU   # optional scoping (Maersk + Hamburg Sud/Sealand)
# MAERSK_TT_PATH=                  # optional path override; sane default baked in

# CMA CGM Public tier — free trial, self-service. Key in the KeyId header.
# CMACGM_API_KEY=...
# CMACGM_KEY_HEADER=KeyId          # set to 'Authorization' if your app expects Bearer
# CMACGM_KEY_PREFIX=               # set to 'Bearer ' (trailing space) with the above
# CMACGM_BASE_URL=                 # override only if CMA gives you a different gateway
# CMACGM_PREFIXES=CMAU,CGMU,APLU,ECMU,APZU   # optional scoping to CMA-group boxes

# Hapag-Lloyd — free, self-service, BETA. You supply the gateway base from your
# portal app. Pick ONE auth style: bearer OR (header+value) OR (api-key header+key).
# HAPAG_BASE_URL=https://your-hapag-gateway/...
# HAPAG_BEARER=...                 # → sends  Authorization: Bearer <token>
# HAPAG_AUTH_HEADER=               # OR an explicit header name ...
# HAPAG_AUTH_VALUE=                #    ... with its value
# HAPAG_API_KEY_HEADER=            # OR an api-key header name ...
# HAPAG_API_KEY=                   #    ... with its key
# HAPAG_EVENTS_PATH=/events        # default
# HAPAG_PREFIXES=HLC,HLX,HPL       # optional scoping

# ZIM — same DCSA pattern as Hapag (ZIM_BASE_URL + one auth style + ZIM_PREFIXES).
# ZIM_BASE_URL=https://your-zim-gateway/...
# ZIM_BEARER=...
# ZIM_PREFIXES=ZIM,ZMO

# Terminal49 — NOT auto-wired (async create-then-poll AND needs a SCAC, so it
# cannot run from a bare container number). Key documented for completeness.
# TERMINAL49_API_KEY=...

# ---------------------------------------------------------------------------
# TIER 4 — SFTP drop-folder ingestion (docker-compose worker + sftp services)
# ---------------------------------------------------------------------------
# Watch root holding inbox/outbox/processed/failed (defaults to /data/sftp in compose).
# CHECKDIGIT_WATCH_ROOT=/data/sftp
# CHECKDIGIT_WATCH_TRUST=1                 # treat dropped text/cells as DECLARED ids
# CHECKDIGIT_WATCH_OWNER_POLICY=strict     # or 'lenient'
# CHECKDIGIT_WATCH_INTERVAL=5              # poll seconds
# CHECKDIGIT_WATCH_STABLE_SCANS=2          # same-size scans before a file is "done"
# CHECKDIGIT_WATCH_MIN_AGE=3               # min file age seconds (half-write guard)
#
# !! The SFTP PASSWORD lives in docker-compose.yml, not here. Before any real
#    partner, replace CHANGE_ME_BEFORE_USE with KEY auth (see DEPLOY.md). The
#    password form is LAN testing ONLY.

# ---------------------------------------------------------------------------
# TIER 5 — offsite SQLite backup (litestream.yml). Configure bucket+creds THERE,
# not here. On a single laptop this is optional but recommended.
# ---------------------------------------------------------------------------
