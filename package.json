{
  "name": "thecheckdigit",
  "version": "0.1.0",
  "description": "Check-digit verification for ISO 6346, ILU and UIC identifiers. Static site; everything runs in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:workspace": "vite build --config vite.workspace.config.ts",
    "test": "vitest run",
    "preview": "wrangler dev",
    "vectors": "node scripts/regen-vectors.mjs",
    "deploy": "wrangler deploy",
    "sync": "node scripts/sync-onedrive.mjs",
    "test:py": "node scripts/run-python-tests.mjs",
    "test:all": "npm test && npm run test:py"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.132.0"
  },
  "private": true
}
